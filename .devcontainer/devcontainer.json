{
  "name": "Odoo 20.0 Community",
  "dockerComposeFile": ["../docker-compose.yaml"],
  "service": "odoo",
  "runServices": ["odoo", "db", "mailpit"],
  "workspaceFolder": "/workspace",
  "remoteUser": "odoo",
  "updateRemoteUserUID": true,
  "shutdownAction": "stopCompose",

  // docker-compose.yaml publishes no port: VS Code forwards these, on another local port when
  // one is taken (Ports view: Change Local Address Port). PostgreSQL is not forwarded
  // (SQLTools reaches db:5432); workers = 0, so the websocket goes through 8069.
  "forwardPorts": [8069, "mailpit:8025"],
  "portsAttributes": {
    "8069": {"label": "Odoo", "onAutoForward": "notify"},
    "mailpit:8025": {"label": "Mailpit", "onAutoForward": "silent"}
  },

  "postCreateCommand": "git config --global --add safe.directory /workspace && mkdir -p .odoo-src && ln -sfn /usr/lib/python3/dist-packages/odoo .odoo-src/odoo && ln -sfn /opt/venv/odoo-addons .odoo-src/oca && npm ci --no-audit --no-fund && pre-commit install --install-hooks",

  "customizations": {
    "vscode": {
      "extensions": [
        "Odoo.odoo",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "charliermarsh.ruff",
        "redhat.vscode-xml",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "EditorConfig.EditorConfig",
        "tamasfe.even-better-toml",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg"
      ],
      "settings": {
        "Odoo.selectedProfile": "Odoo 20",
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "python.analysis.extraPaths": ["/usr/lib/python3/dist-packages"],
        "python.analysis.typeCheckingMode": "off",

        "editor.formatOnSave": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
          }
        },
        "[xml]": {"editor.defaultFormatter": "esbenp.prettier-vscode"},
        "[javascript]": {"editor.defaultFormatter": "esbenp.prettier-vscode"},
        "[scss]": {"editor.defaultFormatter": "esbenp.prettier-vscode"},
        "[css]": {"editor.defaultFormatter": "esbenp.prettier-vscode"},
        "[yaml]": {"editor.defaultFormatter": "esbenp.prettier-vscode"},

        "files.exclude": {"**/__pycache__": true, "**/*.pyc": true},
        // .odoo-src: links to the code of Odoo and of the OCA modules (postCreateCommand),
        // read-only, to browse, search and set breakpoints. Not watched; third-party JS
        // libraries and translations left out of the search.
        "files.watcherExclude": {"**/.odoo-src/**": true},
        "search.exclude": {
          "**/node_modules": true,
          "**/.odoo-src/**/static/lib/**": true,
          "**/.odoo-src/**/i18n/*.po": true
        },

        "sqltools.connections": [
          {
            "name": "Odoo DB",
            "driver": "PostgreSQL",
            "server": "db",
            "port": 5432,
            "username": "odoo",
            "password": "odoo",
            "database": "odoo20"
          }
        ]
      }
    }
  }
}

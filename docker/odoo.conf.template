; Production configuration template (prod image), rendered at container start by
; docker/render-config.py into $ODOO_RC. Placeholders: required variable, or with a
; default after ":-". Database connection: PGHOST, PGPORT, PGUSER, PGPASSWORD (native
; Odoo variables, not in this file). Full list: docs/ci.md.
[options]
addons_path = /opt/odoo/addons,/opt/odoo/vendor
data_dir = /var/lib/odoo
admin_passwd = ${ODOO_ADMIN_PASSWD}

db_name = ${PGDATABASE}
dbfilter = ^${PGDATABASE}$
list_db = ${ODOO_LIST_DB:-False}

; Odoo 20 listens on 127.0.0.1 by default: a container must listen on all interfaces
http_interface = 0.0.0.0
proxy_mode = ${ODOO_PROXY_MODE:-True}

workers = ${ODOO_WORKERS:-2}
max_cron_threads = ${ODOO_MAX_CRON_THREADS:-1}
limit_memory_soft = ${ODOO_LIMIT_MEMORY_SOFT:-2147483648}
limit_memory_hard = ${ODOO_LIMIT_MEMORY_HARD:-2684354560}
limit_time_cpu = ${ODOO_LIMIT_TIME_CPU:-600}
limit_time_real = ${ODOO_LIMIT_TIME_REAL:-1200}

smtp_server = ${ODOO_SMTP_SERVER:-localhost}
smtp_port = ${ODOO_SMTP_PORT:-25}
smtp_ssl = ${ODOO_SMTP_SSL:-False}
smtp_user = ${ODOO_SMTP_USER:-}
smtp_password = ${ODOO_SMTP_PASSWORD:-}
email_from = ${ODOO_EMAIL_FROM:-}

log_level = ${ODOO_LOG_LEVEL:-info}

# Odoo Helm chart deployed by the CI: https://github.com/Skilldron/odoo-helm-chart
# Raise CHART_VERSION to upgrade the chart. CHART in the environment replaces it with a
# local chart directory (development of the chart, ci/chart-e2e.sh).
CHART_REF=oci://ghcr.io/skilldron/charts/odoo
CHART_VERSION=1.0.0

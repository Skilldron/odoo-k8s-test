{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Odoo : lancer (auto-reload, sans debug)",
      "type": "shell",
      "command": "/opt/odoo/odoo-bin -d ${input:database} --dev=all",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Odoo : tests d'un module",
      "type": "shell",
      "command": "/opt/odoo/odoo-bin -d ${input:testDatabase} -i ${input:module} --test-tags /${input:module} --stop-after-init --http-port 8169",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Odoo : supprimer une base",
      "type": "shell",
      "command": "dropdb --if-exists -h db -U odoo ${input:database}",
      "options": {"env": {"PGPASSWORD": "odoo"}},
      "problemMatcher": []
    },
    {
      "label": "Qualité : pre-commit sur tout le dépôt",
      "type": "shell",
      "command": "pre-commit run --all-files",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "database",
      "type": "promptString",
      "description": "Base de données",
      "default": "odoo20"
    },
    {
      "id": "testDatabase",
      "type": "promptString",
      "description": "Base de test",
      "default": "odoo20_test"
    },
    {
      "id": "module",
      "type": "promptString",
      "description": "Module technique (ex. sale_custom)"
    }
  ]
}
